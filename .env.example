# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Credentials (Optional - cloud database sync)
SUPABASE_URL=
SUPABASE_KEY=

# JWT Secret
JWT_SECRET="vortex-secret-123"

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# Google OAuth Credentials (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMTP Configuration (Optional - for sending live OTP emails)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

