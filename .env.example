# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Turso Database Credentials (LibSQL Cloud Database)
TURSO_DATABASE_URL="libsql://edumind-codevortex.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_from_turso_db_tokens_create"

# Supabase Credentials (Legacy / Optional)
SUPABASE_URL=
SUPABASE_KEY=

# JWT Secret (Must be a cryptographically secure 256-bit or 64-character random string in production)
JWT_SECRET="generate_a_long_random_64_character_hex_or_base64_secret_key_for_production"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google OAuth Credentials (Required for real Google Identity Services Sign-In)
GOOGLE_CLIENT_ID="your_real_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_real_google_client_secret"
VITE_GOOGLE_CLIENT_ID="your_real_google_client_id.apps.googleusercontent.com"

# Email / SMTP Configuration (Optional - for sending live OTP emails)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

